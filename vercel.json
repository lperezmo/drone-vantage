  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/tiles.js": {
      "maxDuration": 30
    },
    "api/airspace.js": {
      "maxDuration": 30
    }
  }
}
